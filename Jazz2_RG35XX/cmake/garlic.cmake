set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_SYSROOT "$ENV{RG_SYSROOT}")
set(triple arm-miyoo-linux-uclibcgnueabi)
set(CMAKE_C_COMPILER "$ENV{RG_TOOLCHAIN}/bin/${triple}-gcc")
set(CMAKE_CXX_COMPILER "$ENV{RG_TOOLCHAIN}/bin/${triple}-g++")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(JAZZ2_RG35XX ON)
set(cpu "-marm -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=softfp")
set(CMAKE_C_FLAGS_INIT "${cpu} -DJAZZ2_RG35XX -DJAZZ2_LOGICAL_WIDTH=304 -DJAZZ2_LOGICAL_HEIGHT=228 -I${CMAKE_SYSROOT}/usr/include/SDL2")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,--dynamic-linker,/lib/ld-uClibc.so.0,-rpath-link,${CMAKE_SYSROOT}/lib,-rpath-link,${CMAKE_SYSROOT}/usr/lib")
set(CMAKE_SKIP_RPATH ON)
