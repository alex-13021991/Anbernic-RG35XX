# Build outputs (hundreds of MB, all regenerated by docker/*.sh)
build-*/
device-libs/

# The prebaked content tree and the original game files it is made from. Both are DERIVED FROM
# COPYRIGHTED GAME DATA and must never be committed - see NOTES.md, "Distribuce". The engine is
# GPL-3.0 and freely distributable; the game data is not, and every user brings their own.
out-miyoo/
MiyooPackage/Roms/PORTS/Games/*/Content/
MiyooPackage/Roms/PORTS/Games/*/Source/
releases/
*.tar.gz
*.tar.xz

# Device-side and local run artifacts
log*.txt
crashlogs/
*.stripped
jazz2-A
jazz2-B
jazz2-[0-9]*

# Upstream engine checkout. Not vendored: the repo carries the pinned commit plus our patch series
# (patches/) and docker/fetch-engine.sh reproduces the tree. Keeps this repo small and keeps our
# changes reviewable as changes.
jazz2-native/

# Built binaries belong to a GitHub Release, not to the repository. What stays tracked is the
# package's text: the launch script, alsoft.conf, the .port shortcut and VERSION.
MiyooPackage/Roms/PORTS/Games/*/jazz2
MiyooPackage/Roms/PORTS/Games/*/lib/
build.log

# Staged by docker/stage-packer-tools.sh from the engine checkout and the mingw build. The batch
# file next to them is the only tracked part of the converter.
MiyooPackage/Tools/AssetPacker.exe
MiyooPackage/Tools/EngineContent/

# The Czech working log. Not published: it carries the device's address and local paths, and it is
# a lab notebook rather than documentation. The decisions it argues out are summarised in README.md
# and CHANGELOG.md, which are.
NOTES.md

# Personal VS Code workspace: it names local drive paths and the sibling checkout this machine
# happens to have.
jazz2-miyoo.code-workspace
