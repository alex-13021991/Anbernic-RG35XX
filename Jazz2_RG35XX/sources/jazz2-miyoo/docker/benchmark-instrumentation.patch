diff --git a/Sources/nCine/Graphics/Viewport.cpp b/Sources/nCine/Graphics/Viewport.cpp
index be6796f..e3e4e74 100644
--- a/Sources/nCine/Graphics/Viewport.cpp
+++ b/Sources/nCine/Graphics/Viewport.cpp
@@ -1,4 +1,5 @@
 #include "Viewport.h"
+#include "../Base/TimeStamp.h"
 #include "RenderQueue.h"
 #include "RenderResources.h"
 #include "../Application.h"
@@ -302,6 +303,31 @@ namespace nCine
 			ZoneScopedC(0x81A861);
 			std::uint32_t visitOrderIndex = 0;
 			_rootNode->OnVisit(_renderQueue, visitOrderIndex);
+
+#if defined(JAZZ2_LOGICAL_WIDTH) && defined(JAZZ2_LOGICAL_HEIGHT)
+			// BENCHMARK PATCH: how many nodes the traversal actually walks.
+			//
+			// On the Miyoo this phase swings from 1.6 ms in a quiet scene to 10 ms near the level's
+			// fire, and the point of this counter is to tell the two possible causes apart: many more
+			// nodes (an effect spawning them), or the same nodes costing more each. Guessing which
+			// actor is responsible without this would be exactly the mistake made over the START
+			// button. Revert with `git checkout Sources/nCine/Graphics/Viewport.cpp`.
+			{
+				static TimeStamp lastNodeReport = TimeStamp::now();
+				static std::uint32_t nodesAccum = 0, nodesPeak = 0, nodeFrames = 0;
+				nodesAccum += visitOrderIndex;
+				if (visitOrderIndex > nodesPeak) {
+					nodesPeak = visitOrderIndex;
+				}
+				nodeFrames++;
+				if (lastNodeReport.secondsSince() >= 5.0f) {
+					LOGI("[NODES] {} frames: {} nodes average, {} peak", nodeFrames,
+						nodesAccum / (nodeFrames > 0 ? nodeFrames : 1), nodesPeak);
+					nodesAccum = nodesPeak = nodeFrames = 0;
+					lastNodeReport = TimeStamp::now();
+				}
+			}
+#endif
 		}
 
 		_stateBits.set(StateBitPositions::VisitedBit);
