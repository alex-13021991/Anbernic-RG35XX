--- /dev/null
+++ b/tools/generate_fonts.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+from pathlib import Path
+from PIL import Image,ImageDraw,ImageFont
+root=Path(__file__).resolve().parents[1]
+out=root/'data/fonts'
+out.mkdir(exist_ok=True)
+for source in sorted((root/'data/images/status').glob('letters*.png')):
+    original=Image.open(source).convert('RGBA')
+    w,h=original.width//16,original.height//6
+    atlas=Image.new('RGBA',(16*w,11*h))
+    atlas.paste(original,(0,0))
+    colors={'white':(255,255,255),'black':(0,0,0),'gold':(255,210,0),
+            'silver':(200,200,200),'blue':(0,185,245),'red':(255,50,45),'green':(40,230,70)}
+    color=next((v for k,v in colors.items() if k in source.name),(255,255,255))
+    font=ImageFont.truetype(str(root/'tools/font-source/DejaVuSansMono-Bold.ttf'),h*4)
+    letters=[chr(c) for c in range(0x410,0x450)]+['Ё','ё']
+    for n,ch in enumerate(letters):
+        stroke=3 if h>=16 else 0
+        box=font.getbbox(ch,stroke_width=stroke)
+        glyph=Image.new('RGBA',(box[2]-box[0]+2,box[3]-box[1]+2))
+        ImageDraw.Draw(glyph).text((1-box[0],1-box[1]),ch,font=font,fill=color+(255,),
+                                  stroke_width=stroke,stroke_fill=(0,0,0,255))
+        # Fit the full glyph, including descenders and accents, in its fixed cell.
+        glyph.thumbnail(((w-1)*4,(h-2)*4),Image.Resampling.LANCZOS)
+        glyph=glyph.resize((max(1,glyph.width//4),max(1,glyph.height//4)),Image.Resampling.LANCZOS)
+        x=(n%16)*w+(w-glyph.width)//2
+        y=(6+n//16)*h+(h-glyph.height)//2
+        atlas.alpha_composite(glyph,(x,y))
+    atlas.save(out/source.name)
+(root/'data/fonts/LICENSE-DejaVu.txt').write_bytes((root/'tools/font-source/LICENSE-DejaVu.txt').read_bytes())
