--- /dev/null
+++ b/platform/utf8.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <string>
+// Text and resource metadata stay UTF-8; only the font lookup uses compact slots.
+inline std::string font_bytes(const char* text) {
+    std::string out;
+    if(!text) return out;
+    const unsigned char* p=(const unsigned char*)text;
+    while(*p) {
+        unsigned cp=*p++;
+        if(cp>=0xC2 && cp<=0xDF && (*p&0xC0)==0x80) {
+            cp=((cp&31)<<6)|(*p++&63);
+        } else if(cp>=0xE0 && cp<=0xEF && p[0] && p[1] &&
+                  (p[0]&0xC0)==0x80 && (p[1]&0xC0)==0x80) {
+            cp=((cp&15)<<12)|((p[0]&63)<<6)|(p[1]&63); p+=2;
+        }
+        if(cp>=0x410 && cp<=0x44F) out+=(char)(0xC0+cp-0x410);
+        else if(cp==0x401) out+=(char)0xA8;
+        else if(cp==0x451) out+=(char)0xB8;
+        else if(cp==0x2014 || cp==0x2013) out+='-';
+        else if(cp==0x201C || cp==0x201D || cp==0xAB || cp==0xBB) out+='"';
+        else if(cp==0x2019) out+=(char)39;
+        else if(cp<128) out+=(char)cp;
+        else out+='?';
+    }
+    return out;
+}
+inline int text_length(const char* text) { return font_bytes(text).size(); }
