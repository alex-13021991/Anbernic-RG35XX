@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "pak.h"
+#include <SDL_image.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <climits>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <set>
+#include <zlib.h>
+namespace {
+struct Entry { uint64_t offset,size; uint32_t crc; bool verified; };
+std::map<std::string,Entry> entries;
+unsigned char* mapped=0;
+size_t mapped_size=0;
+std::string resource_root;
+uint16_t u16(const unsigned char* p) { return p[0]|(uint16_t(p[1])<<8); }
+uint32_t u32(const unsigned char* p) { return u16(p)|(uint32_t(u16(p+2))<<16); }
+uint64_t u64(const unsigned char* p) { return u32(p)|(uint64_t(u32(p+4))<<32); }
+void fail(const char* reason) { fprintf(stderr,"SuperTux PAK: %s\n",reason); exit(1); }
+std::string normalized(const std::string& path) {
+ std::string full=path;
+ if(full.empty() || full[0]!='/') { char cwd[4096]; if(!getcwd(cwd,sizeof(cwd))) fail("getcwd"); full=std::string(cwd)+"/"+full; }
+ std::vector<std::string> parts;
+ for(size_t i=0;i<full.size();) {
+  size_t end=full.find('/',i); if(end==std::string::npos)end=full.size();
+  std::string part=full.substr(i,end-i);
+  if(part=="..") { if(!parts.empty())parts.pop_back(); }
+  else if(!part.empty() && part!=".") parts.push_back(part);
+  i=end+1;
+ }
+ std::string result;
+ for(size_t i=0;i<parts.size();++i) result+="/"+parts[i];
+ return result;
+}
+std::string relative(const std::string& path) {
+ std::string full=normalized(path);
+ if(full.compare(0,resource_root.size()+1,resource_root+"/")!=0) return std::string();
+ return full.substr(resource_root.size()+1);
+}
+Entry* lookup(const char* path) {
+ if(!mapped)return 0;
+ std::string name=relative(path);
+ std::map<std::string,Entry>::iterator it=entries.find(name);
+ if(it==entries.end())return 0;
+ Entry& e=it->second;
+ if(!e.verified) {
+  if(crc32(0,mapped+e.offset,(uInt)e.size)!=e.crc) fail(("checksum: "+name).c_str());
+  e.verified=true;
+ }
+ return &e;
+}
+SDL_RWops* rw(const char* path) {
+ if(Entry* e=lookup(path)) return SDL_RWFromConstMem(mapped+e->offset,(int)e->size);
+ return SDL_RWFromFile(path,"rb");
+}
+}
+void pak_init(const std::string& root) {
+ resource_root=normalized(root);
+ std::string filename=resource_root+".pak";
+ int fd=open(filename.c_str(),O_RDONLY);
+ if(fd<0) { fprintf(stderr,"SuperTux: loose resources at %s\n",root.c_str()); return; }
+ struct stat st;
+ if(fstat(fd,&st)<0 || st.st_size<16 || uint64_t(st.st_size)>1024ULL*1024*1024) fail("invalid file size");
+ mapped_size=(size_t)st.st_size;
+ void* mem=mmap(0,mapped_size,PROT_READ,MAP_PRIVATE,fd,0); close(fd);
+ if(mem==MAP_FAILED) fail("mmap");
+ mapped=(unsigned char*)mem;
+ if(memcmp(mapped,"STPAK1\0\0",8))fail("invalid magic");
+ uint32_t count=u32(mapped+8),index_size=u32(mapped+12);
+ if(count>100000 || index_size>mapped_size-16)fail("invalid index");
+ size_t cursor=16,end=16+index_size;
+ for(uint32_t n=0;n<count;++n) {
+  if(cursor>end || end-cursor<24)fail("truncated entry");
+  unsigned length=u16(mapped+cursor);
+  if(u16(mapped+cursor+2)!=0)fail("unsupported flags");
+  Entry e; e.crc=u32(mapped+cursor+4);e.offset=u64(mapped+cursor+8);e.size=u64(mapped+cursor+16);e.verified=false;
+  cursor+=24;
+  if(!length || length>end-cursor || e.offset<end || e.offset>mapped_size || e.size>mapped_size-e.offset || e.size>INT_MAX)fail("invalid entry bounds");
+  std::string name((char*)mapped+cursor,length);cursor+=length;
+  if(name[0]=='/' || name.find('\\')!=std::string::npos || name.find("..")!=std::string::npos ||
+     name.find(char(0))!=std::string::npos || entries.count(name))fail("invalid resource name");
+  entries[name]=e;
+ }
+ if(cursor!=end)fail("invalid index length");
+ fprintf(stderr,"SuperTux: data.pak, %u resources, %u bytes, stored/uncompressed\n",count,(unsigned)mapped_size);
+}
+FILE* pak_fopen(const char* path,const char* mode) {
+ if(mode[0]=='r' && !strchr(mode,'+'))
+  if(Entry* e=lookup(path)) return fmemopen(mapped+e->offset,(size_t)e->size,"rb");
+ return fopen(path,mode);
+}
+bool pak_exists(const char* path) { return lookup(path)!=0; }
+std::vector<std::string> pak_children(const std::string& path,bool directories) {
+ std::set<std::string> result;
+ if(mapped) {
+  std::string prefix=relative(path+"/_"); if(!prefix.empty())prefix.erase(prefix.size()-1);
+  if(!prefix.empty())
+   for(std::map<std::string,Entry>::const_iterator i=entries.begin();i!=entries.end();++i) {
+    if(i->first.compare(0,prefix.size(),prefix))continue;
+    std::string tail=i->first.substr(prefix.size());
+    size_t slash=tail.find('/');
+    if(directories && slash!=std::string::npos)result.insert(tail.substr(0,slash));
+    if(!directories && slash==std::string::npos)result.insert(tail);
+   }
+ }
+ return std::vector<std::string>(result.begin(),result.end());
+}
+SDL_Surface* pak_image(const char* path) { return IMG_Load_RW(rw(path),1); }
+Mix_Chunk* pak_wave(const char* path) { return Mix_LoadWAV_RW(rw(path),1); }
+Mix_Music* pak_music(const char* path) {
+ SDL_RWops* input=rw(path);
+ if(!input)return 0;
+ return Mix_LoadMUSType_RW(input,MUS_NONE,1);
+}
