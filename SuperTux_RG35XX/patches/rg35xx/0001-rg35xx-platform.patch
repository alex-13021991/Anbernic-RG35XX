+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <SDL.h>
+inline SDLKey rg_button_key(unsigned code) {
+ switch(code) {
+ case 0x130:return SDLK_LCTRL;
+ case 0x131:return SDLK_SPACE;
+ case 0x133:return SDLK_LSHIFT;
+ case 0x134:return SDLK_LALT;
+ case 0x13a:case 0x13c:return SDLK_ESCAPE;
+ default:return SDLK_UNKNOWN;
+ }
+}
+inline const char* rg_button_name(int key) {
+ switch(key) {
+ case SDLK_LCTRL:return "A";
+ case SDLK_SPACE:return "B";
+ case SDLK_LSHIFT:return "X";
+ case SDLK_LALT:return "Y";
+ default:return 0;
+ }
+}
+inline bool rg_bindable(int key) {
+ return rg_button_name(key) || key==SDLK_UP || key==SDLK_DOWN ||
+   key==SDLK_LEFT || key==SDLK_RIGHT;
+}
