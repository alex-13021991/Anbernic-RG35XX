+.DEFAULT_GOAL := supertux
+export LD_LIBRARY_PATH = $(SDK)/lib
+SDK ?= $(HOME)/RG35XX/RG35XX-SDK/miyoo-gcc-7.3.0
+SYSROOT ?= $(CURDIR)/../sysroot
+CXX = $(SDK)/bin/arm-linux-g++
+CPU = -marm -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=softfp
+CPPFLAGS = -DNOOPENGL -DHAVE_SOUND -DRG35XX -DVERSION=\"0.1.3-rg35xx-0.1.2\"
+CXXFLAGS = $(CPU) --sysroot=$(SYSROOT) -O2 -std=gnu++03 -Wall -I$(SYSROOT)/usr/include/SDL -include platform/rg35xx.h
+LDLIBS = -lSDL_mixer -lSDL_image -lSDL_gfx -lSDL -lz -lm -lpthread
+LDFLAGS = $(CPU) --sysroot=$(SYSROOT) -Wl,-rpath-link,$(SYSROOT)/usr/lib:$(SYSROOT)/lib
+build/platform/rg35xx.o: CPPFLAGS += -DRG_IMPLEMENTATION
+
+SOURCES = $(wildcard src/*.cpp) platform/rg35xx.cpp platform/pak.cpp
+OBJECTS = $(patsubst %.cpp,build/%.o,$(SOURCES))
+supertux: $(OBJECTS)
+	$(CXX) $(LDFLAGS) $^ $(LDLIBS) -o $@
+build/%.o: %.cpp platform/rg35xx.h platform/buttons.h platform/pak.h
+	@mkdir -p $(dir $@)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@
