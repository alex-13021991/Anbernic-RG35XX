+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+import argparse,struct,zlib,hashlib
+from pathlib import Path
+MAGIC=b'STPAK1\0\0'
+def build(source,output):
+    files=[]
+    for item in sorted(source.rglob('*')):
+        if item.is_symlink():raise ValueError('Symlink resource: '+str(item))
+        if item.is_file():
+            name=item.relative_to(source).as_posix().encode('utf8')
+            data=item.read_bytes()
+            if len(name)>65535:raise ValueError('Resource name too long')
+            files.append((name,data))
+    index_size=sum(24+len(name) for name,data in files)
+    offset=(16+index_size+7)&~7
+    records=[]
+    for name,data in files:
+        records.append((name,data,offset))
+        offset=(offset+len(data)+7)&~7
+    output.parent.mkdir(parents=True,exist_ok=True)
+    temporary=output.with_suffix(output.suffix+'.tmp')
+    with temporary.open('wb') as stream:
+        stream.write(MAGIC+struct.pack('<II',len(files),index_size))
+        for name,data,offset in records:
+            stream.write(struct.pack('<HHIQQ',len(name),0,zlib.crc32(data),offset,len(data))+name)
+        for name,data,offset in records:
+            stream.write(bytes(offset-stream.tell()))
+            stream.write(data)
+    temporary.replace(output)
+    validate(output,source)
+    print(str(output)+': '+str(len(files))+' files, '+str(output.stat().st_size)+' bytes, no compression')
+def validate(path,source=None):
+    data=path.read_bytes()
+    if len(data)<16 or data[:8]!=MAGIC:raise ValueError('Bad PAK header')
+    count,index_size=struct.unpack_from('<II',data,8)
+    cursor=16;end=16+index_size;names=set();ranges=[]
+    if end>len(data) or count>100000:raise ValueError('Bad index length')
+    for _ in range(count):
+        if cursor+24>end:raise ValueError('Truncated entry')
+        length,flags,crc,offset,size=struct.unpack_from('<HHIQQ',data,cursor);cursor+=24
+        if not length or cursor+length>end:raise ValueError('Bad name')
+        name=data[cursor:cursor+length].decode('utf8');cursor+=length
+        if flags or name in names or name.startswith('/') or '..' in name or '\\' in name or '\0' in name:raise ValueError('Unsafe name')
+        if offset<end or offset+size>len(data):raise ValueError('Bad bounds')
+        content=data[offset:offset+size]
+        if zlib.crc32(content)!=crc:raise ValueError('CRC: '+name)
+        if source is not None and (source/name).read_bytes()!=content:raise ValueError('Data mismatch: '+name)
+        names.add(name);ranges.append((offset,offset+size))
+    if cursor!=end:raise ValueError('Index length mismatch')
+    ranges.sort()
+    if any(a[1]>b[0] for a,b in zip(ranges,ranges[1:])):raise ValueError('Overlapping entries')
+    if source is not None:
+        expected={x.relative_to(source).as_posix() for x in source.rglob('*') if x.is_file()}
+        if names!=expected:raise ValueError('File list mismatch')
+    return len(names)
+if __name__=='__main__':
+    ap=argparse.ArgumentParser(description='STPAK1: indexed uncompressed SuperTux resources')
+    ap.add_argument('source',type=Path);ap.add_argument('output',type=Path)
+    args=ap.parse_args();build(args.source,args.output)
