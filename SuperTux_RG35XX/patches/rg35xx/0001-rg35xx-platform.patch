+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+import argparse,re,subprocess,time
+from pathlib import Path
+ap=argparse.ArgumentParser()
+ap.add_argument('--qemu',type=Path,required=True)
+ap.add_argument('--app',type=Path,required=True)
+ap.add_argument('--session',default='supertux-ui-regression')
+a=ap.parse_args()
+root=a.qemu/'state'/a.session
+process=None
+def launch():
+ global process
+ process=subprocess.Popen([str(a.qemu/'rg35xx'),'run','--session',a.session,
+  '--app',str(a.app),'--exec','supertux','--headless','--seconds','180'],stdout=subprocess.DEVNULL)
+ for _ in range(200):
+  time.sleep(.1)
+  if process.poll() is not None:raise AssertionError('Game exited before startup')
+  log=root/'console.log'
+  if log.exists() and 'input=' in log.read_text(errors='replace'):time.sleep(2);return
+ raise AssertionError('Startup timeout')
+def key(button,hold='.12'):
+ result=subprocess.run([str(a.qemu/'rg35xx'),'key',button,'--hold',str(hold),'--session',a.session],stdout=subprocess.DEVNULL,stderr=subprocess.PIPE)
+ if result.returncode:
+  # A successful long-MENU exit can close the modeled FIFO before key release.
+  if button!='menu' or float(hold)<1.5 or process.wait(timeout=3)!=0:
+   raise AssertionError(result.stderr.decode('utf8','replace'))
+ time.sleep(.12)
+def keys(*items):
+ for button in items:key(button)
+def config():
+ file=root/'root/mnt/mmc/CFW/.supertux/config'
+ return {k:int(v) for k,v in re.findall(r'\(keyboard-(\w+)\s+(-?\d+)\)',file.read_text())}
+def controls():keys('down','down','a','down','down','down','a')
+defaults={'jump':306,'duck':274,'left':276,'right':275,'fire':32}
+try:
+ launch();controls()
+ keys('down','down','down','down','down','a')
+ assert config()==defaults,config()
+ keys('up','up','up','up','up','down','down','down','down')
+ assert config()==defaults,config()
+ keys('a','x');assert config()['fire']==304,config()
+ keys('a','y');assert config()['fire']==308,config()
+ keys('a','menu');assert config()['fire']==308,config()
+ keys('a','b');assert config()['fire']==32,config()
+ keys('a','l1','r1','l2','r2');assert config()['fire']==32,config()
+ keys('y');assert config()['fire']==308,config()
+ keys('menu')
+ assert process.poll() is None,'Short MENU exited'
+ key('menu','1.7');assert process.wait(timeout=8)==0
+ print('PASS navigation, explicit capture, B/X/Y, cancel, ignored shoulders, short/long MENU')
+ launch();assert config()['fire']==308,'Mapping did not survive restart'
+ controls();keys('down','down','down','down','down','a')
+ assert config()==defaults,'Reset failed'
+ keys('menu','menu','up','up','a','a')
+ time.sleep(.5);keys('menu');time.sleep(.4);keys('down','a')
+ time.sleep(3.5)
+ key('menu','1.7');assert process.wait(timeout=10)==0
+ slot=root/'root/mnt/mmc/CFW/.supertux/save/slot1.stsg'
+ assert slot.is_file(),'Long MENU did not save world progress'
+ assert config()==defaults
+ assert 'savegame:' in (root/'console.log').read_text(errors='replace')
+ print('PASS restart persistence, reset, packed first level, long MENU exits with slot/config saved')
+ launch()
+ keys('a','a')
+ time.sleep(.7)
+ key('menu','1.7')
+ assert process.wait(timeout=10)==0,'Long MENU lost during intro/loading transition'
+ print('PASS long MENU across intro/loading transition')
+
+finally:
